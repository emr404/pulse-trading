# Default: simulated stocks and historical charts. No keys required.
MARKET_MODE=demo
HOST=127.0.0.1
PORT=3001

# Live data only; never prefix secrets with VITE_. All trades remain simulated.
# Set MARKET_MODE=live, supply Alpaca market-data keys, and restart the server.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# iex or sip. Your Alpaca subscription must permit the selected feed.
ALPACA_FEED=iex

# Comma-separated US tickers (maximum 50). Unknown tickers display their symbol.
MARKET_SYMBOLS=AAPL,NVDA,TSLA,MSFT,AMZN,GOOGL,META,AMD,JPM,SPY,QQQ,DIA
# Demo/live stock portfolios are separate. Old crypto portfolio files are preserved.
# DATA_FILE=.data/stocks-demo.json

# Separately hosted frontend/backend (leave blank for local development).
# GitHub Pages origin only, without the repository path. Comma-separated if needed.
FRONTEND_ORIGIN=
# Public backend origin, e.g. https://pulse-api.example.com (no /api suffix).
VITE_API_URL=
# Optional override; defaults to the backend origin with wss:// and /ws.
VITE_WS_URL=
# On backend hosting, use HOST=0.0.0.0 and a persistent DATA_FILE location.
